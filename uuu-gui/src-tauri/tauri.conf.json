{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board Flasher",
  "version": "0.2.0",
  "identifier": "com.popoto.board-flasher",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Board Flasher",
        "width": 860,
        "height": 760,
        "minWidth": 640,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/uuu"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
